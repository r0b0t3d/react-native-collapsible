{
  "name": "@r0b0t3d/react-native-collapsible",
  "version": "1.6.0",
  "description": "Fully customizable collapsible views",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.tsx",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./plugins/CollapsibleFlashList": {
      "types": "./lib/typescript/plugins/CollapsibleFlashList.d.ts",
      "react-native": "./src/plugins/CollapsibleFlashList.tsx",
      "import": "./lib/module/plugins/CollapsibleFlashList.js",
      "require": "./lib/commonjs/plugins/CollapsibleFlashList.js"
    },
    "./plugins/CollapsibleLegendList": {
      "types": "./lib/typescript/plugins/CollapsibleLegendList.d.ts",
      "react-native": "./src/plugins/CollapsibleLegendList.tsx",
      "import": "./lib/module/plugins/CollapsibleLegendList.js",
      "require": "./lib/commonjs/plugins/CollapsibleLegendList.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!lib/typescript/example",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "prepack": "bob build",
    "release": "release-it",
    "example": "yarn --cwd example",
    "bootstrap": "yarn example && yarn install"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/r0b0t3d/react-native-collapsible",
  "author": "Tuan Luong <tuanluong.it@gmail.com> (https://github.com/r0b0t3d)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/r0b0t3d/react-native-collapsible/issues"
  },
  "homepage": "https://github.com/r0b0t3d/react-native-collapsible#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.2.2",
    "@legendapp/list": "^3.0.6",
    "@react-native-community/eslint-config": "^3.2.0",
    "@release-it/conventional-changelog": "^5.0.0",
    "@shopify/flash-list": "^2.3.2",
    "@types/jest": "^28.1.2",
    "@types/react": "~19.2.17",
    "@types/react-native": "0.70.0",
    "commitlint": "^17.0.2",
    "del-cli": "^5.0.0",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^28.1.1",
    "pod-install": "^0.1.0",
    "prettier": "^3.8.4",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.20.0",
    "react-native-reanimated": "^4.4.1",
    "release-it": "^20.2.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@legendapp/list": "*",
    "@shopify/flash-list": "*",
    "react": ">=18.0.0",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@legendapp/list": {
      "optional": true
    },
    "@shopify/flash-list": {
      "optional": true
    }
  },
  "engines": {
    "node": ">= 16.0.0"
  },
  "jest": {
    "preset": "react-native",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^react-native-reanimated$": "<rootDir>/jest.setup.js"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "tsc": "node_modules/.bin/tsc"
        }
      ]
    ]
  }
}
